# ============================================================
# Maintenance Proactif du Parc Informatique par IA
# Environment Variables Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to Git!
#
# Windows: copy .env.example .env
# Linux/Mac: cp .env.example .env
# ============================================================

# --- Application ---
APP_NAME="Maintenance Proactif API"
APP_VERSION=1.0.0
DEBUG=true

# --- Database ---
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/proactive_maintenance
DATABASE_ECHO=false

# --- JWT Authentication ---
# CHANGE THIS IN PRODUCTION! Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-generate-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (Frontend URLs allowed to call the API) ---
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# --- Metrics Collection ---
DEFAULT_COLLECTION_INTERVAL=60

# --- AI/ML ---
ANOMALY_CONTAMINATION=0.1
AI_MODEL_PATH=models/isolation_forest_v1.joblib

# --- Email Notifications (optional) ---
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# --- Data Retention ---
METRICS_RETENTION_DAYS=30
